"""
parking_ultrasonic: garage parking-aid distance-display add-on board.

Carrier for a SparkFun SEN-15569 HC-SR04 and an Adafruit 326 SSD1306 OLED, plus a
red/green stop LED and a passive piezo, all driven by an external 3.3 V or 5 V host
over one 10-pin JST XH cable. See specs/parking-distance-display.md.

Host cable J1 (JST XH, 2.50 mm):
  1 GND   2 +5V   3 VIO (host logic rail, 3.3 V or 5 V)
  4 SDA   5 SCL   6 TRIG   7 ECHO   8 LED_R   9 LED_G   10 BUZZ
"""

load("@stdlib/units.zen", "Voltage")

Resistor = Module("@stdlib/generics/Resistor.zen")
Capacitor = Module("@stdlib/generics/Capacitor.zen")
Led = Module("@stdlib/generics/Led.zen")
Tvs = Module("@stdlib/generics/Tvs.zen")
MountingHole = Module("@stdlib/generics/MountingHole.zen")

ADAFRUIT_326_SSD1306_OLED = Module("./components/adafruit-326-ssd1306-oled/zener/ADAFRUIT_326_SSD1306_OLED.zen")
SPARKFUN_SEN_15569_HC_SR04 = Module("./components/sparkfun-sen-15569-hc-sr04/zener/SPARKFUN_SEN_15569_HC_SR04.zen")
JstXh10Side = Module("./components/local/JstXh10Side.zen")
Polyfuse1206 = Module("./components/local/Polyfuse1206.zen")
Buffer1G125 = Module("./components/local/Buffer1G125.zen")
AO3400A = Module("./components/local/AO3400A.zen")
BicolorLed = Module("./components/local/BicolorLed.zen")
PiezoPS1240 = Module("./components/local/PiezoPS1240.zen")

# ---------------------------------------------------------------- nets
GND = Ground("GND")
V5_IN = Power("V5_IN", voltage=Voltage("5V"))  # host 5 V before protection
V5 = Power("V5", voltage=Voltage("5V"))  # protected 5 V rail
VIO = Power("VIO", voltage=Voltage("3.3V to 5V"))  # host logic rail

SDA = Net("SDA")
SCL = Net("SCL")
TRIG_HOST = Net("TRIG_HOST")  # VIO-level trigger from host
TRIG_5V = Net("TRIG_5V")  # 5 V trigger to HC-SR04
ECHO_5V = Net("ECHO_5V")  # 5 V echo from HC-SR04
ECHO_BUF = Net("ECHO_BUF")  # VIO-level echo before series resistor
ECHO_HOST = Net("ECHO_HOST")  # VIO-level echo to host
LED_R = Net("LED_R")
LED_G = Net("LED_G")
BUZZ = Net("BUZZ")

# ---------------------------------------------------------------- host connector + protection
JstXh10Side(
    name="J1",
    P1=GND,
    P2=V5_IN,
    P3=VIO,
    P4=SDA,
    P5=SCL,
    P6=TRIG_HOST,
    P7=ECHO_HOST,
    P8=LED_R,
    P9=LED_G,
    P10=BUZZ,
)

# PTC in series; TVS after it so a reversed or over-voltage supply is clamped and trips the PTC.
Polyfuse1206(name="F1", P1=V5_IN, P2=V5)
Tvs(
    name="D2",
    package="DO-214AC",
    direction="Unidirectional",
    reverse_standoff_voltage=Voltage("5V"),
    mpn="SMAJ5.0A",
    manufacturer="Littelfuse",
    A=GND,
    K=V5,
)
Capacitor(name="C1", value="10uF", package="0805", mpn="CL21A106KOQNNNE", manufacturer="Samsung Electro-Mechanics", voltage=Voltage("16V"), dielectric="X5R", P1=V5, P2=GND)
Capacitor(name="C2", value="100nF", package="0805", mpn="CL21B104KBCNNNC", manufacturer="Samsung Electro-Mechanics", voltage=Voltage("50V"), dielectric="X7R", P1=V5, P2=GND)
Capacitor(name="C3", value="1uF", package="0805", mpn="CL21B105KOFNNNE", manufacturer="Samsung Electro-Mechanics", voltage=Voltage("16V"), dielectric="X7R", P1=VIO, P2=GND)

# Power indicator: ~1.3 mA from 5 V
PWR_LED_A = Net("PWR_LED_A")
Resistor(name="R1", value="2.2kohm", package="0805", mpn="RC0805FR-072K2L", manufacturer="YAGEO", P1=V5, P2=PWR_LED_A)
Led(
    name="D3",
    package="0805",
    color="green",
    mpn="LTST-C171KGKT",
    manufacturer="Lite-On",
    A=PWR_LED_A,
    K=GND,
)

# ---------------------------------------------------------------- HC-SR04 and level shifting
SPARKFUN_SEN_15569_HC_SR04(name="J2", VCC=V5, TRIG=TRIG_5V, ECHO=ECHO_5V, GND=GND)

# TRIG: VIO -> 5 V. AHCT input VIH = 2.0 V at VCC 5 V, so a 3.3 V host drives it cleanly.
Resistor(name="R2", value="100kohm", package="0805", mpn="RC0805FR-07100KL", manufacturer="YAGEO", P1=TRIG_HOST, P2=GND)
Buffer1G125(name="U1", mpn="SN74AHCT1G125DBVR", OE=GND, A=TRIG_HOST, Y=TRIG_5V, VCC=V5, GND=GND)
Capacitor(name="C4", value="100nF", package="0805", mpn="CL21B104KBCNNNC", manufacturer="Samsung Electro-Mechanics", voltage=Voltage("50V"), dielectric="X7R", P1=V5, P2=GND)

# ECHO: 5 V -> VIO. LVC inputs are 5.5 V tolerant at any VCC; output swings to VIO.
Resistor(name="R3", value="100kohm", package="0805", mpn="RC0805FR-07100KL", manufacturer="YAGEO", P1=ECHO_5V, P2=GND)
Buffer1G125(name="U2", mpn="SN74LVC1G125DBVR", OE=GND, A=ECHO_5V, Y=ECHO_BUF, VCC=VIO, GND=GND)
Capacitor(name="C5", value="100nF", package="0805", mpn="CL21B104KBCNNNC", manufacturer="Samsung Electro-Mechanics", voltage=Voltage("50V"), dielectric="X7R", P1=VIO, P2=GND)
Resistor(name="R4", value="33ohm", package="0805", mpn="RC0805FR-0733RL", manufacturer="YAGEO", P1=ECHO_BUF, P2=ECHO_HOST)

# ---------------------------------------------------------------- OLED (I2C, powered from VIO)
ADAFRUIT_326_SSD1306_OLED(
    name="DS1",
    SDA=SDA,
    SCL=SCL,
    DC_SA0=NotConnected(),  # board default strap, I2C address 0x3D
    RST=NotConnected(),  # onboard auto-reset
    CS=NotConnected(),  # unused in I2C mode
    V3V3=NotConnected(),  # module regulator output, unused
    VIN=VIO,
    GND=GND,
)
# Extra I2C pull-ups to the host logic rail for the cable run.
Resistor(name="R5", value="4.7kohm", package="0805", mpn="RC0805FR-074K7L", manufacturer="YAGEO", P1=VIO, P2=SDA)
Resistor(name="R6", value="4.7kohm", package="0805", mpn="RC0805FR-074K7L", manufacturer="YAGEO", P1=VIO, P2=SCL)

# ---------------------------------------------------------------- stop LED (common anode, low-side switched from 5 V)
LED_A = V5
K_RED = Net("K_RED")
K_GREEN = Net("K_GREEN")
Q_RED_D = Net("Q_RED_D")
Q_GRN_D = Net("Q_GRN_D")
G_RED = Net("G_RED")
G_GRN = Net("G_GRN")

BicolorLed(name="D1", A=LED_A, K_RED=K_RED, K_GREEN=K_GREEN)
# Red Vf 1.95 V: (5 - 1.95) / 220 = 13.9 mA. Green Vf 2.1 V: 13.2 mA.
Resistor(name="R7", value="220ohm", package="0805", mpn="RC0805FR-07220RL", manufacturer="YAGEO", P1=K_RED, P2=Q_RED_D)
Resistor(name="R8", value="220ohm", package="0805", mpn="RC0805FR-07220RL", manufacturer="YAGEO", P1=K_GREEN, P2=Q_GRN_D)

Resistor(name="R9", value="100ohm", package="0805", mpn="RC0805FR-07100RL", manufacturer="YAGEO", P1=LED_R, P2=G_RED)
Resistor(name="R10", value="100kohm", package="0805", mpn="RC0805FR-07100KL", manufacturer="YAGEO", P1=G_RED, P2=GND)
AO3400A(name="Q1", G=G_RED, D=Q_RED_D, S=GND)

Resistor(name="R11", value="100ohm", package="0805", mpn="RC0805FR-07100RL", manufacturer="YAGEO", P1=LED_G, P2=G_GRN)
Resistor(name="R12", value="100kohm", package="0805", mpn="RC0805FR-07100KL", manufacturer="YAGEO", P1=G_GRN, P2=GND)
AO3400A(name="Q2", G=G_GRN, D=Q_GRN_D, S=GND)

# ---------------------------------------------------------------- piezo (host PWM tone, low-side switched from 5 V)
BZ_N = Net("BZ_N")
G_BZ = Net("G_BZ")
PiezoPS1240(name="BZ1", POS=V5, NEG=BZ_N)
Resistor(name="R13", value="1kohm", package="0805", mpn="RC0805FR-071KL", manufacturer="YAGEO", P1=V5, P2=BZ_N)  # recharges piezo when FET is off
Resistor(name="R14", value="100ohm", package="0805", mpn="RC0805FR-07100RL", manufacturer="YAGEO", P1=BUZZ, P2=G_BZ)
Resistor(name="R15", value="100kohm", package="0805", mpn="RC0805FR-07100KL", manufacturer="YAGEO", P1=G_BZ, P2=GND)
AO3400A(name="Q3", G=G_BZ, D=BZ_N, S=GND)

# ---------------------------------------------------------------- case mounting holes (M3, non-plated)
MountingHole(name="H1", diameter="M3", plating="Mechanical")
MountingHole(name="H2", diameter="M3", plating="Mechanical")
MountingHole(name="H3", diameter="M3", plating="Mechanical")
MountingHole(name="H4", diameter="M3", plating="Mechanical")

Board(
    name="parking_ultrasonic",
    layout_path="layout",
    layers=2,
)

